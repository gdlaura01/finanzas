{
  "name": "finanzas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:sembrar": "tsx scripts/sembrar.ts",
    "db:preparar": "npm run db:migrar && npm run db:sembrar",
