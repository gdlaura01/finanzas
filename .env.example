# Copia este archivo como .env.local y rellénalo. Nunca lo subas al repositorio.

# Ruta de la base de datos (por defecto ./data/finanzas.db)
DB_PATH=./data/finanzas.db

# Acceso: lo rellena `npm run crear-acceso`. Si lo escribes a mano, escapa cada $ del hash como \$
APP_EMAIL=
APP_PASSWORD_HASH=
# Secreto para firmar la cookie de sesión (32 caracteres o más). Cambiarlo cierra todas las sesiones.
SESSION_SECRET=
# Pon true solo si sirves la app por https
COOKIE_SECURE=false

# Google Drive: ruta al JSON del cliente OAuth, fuera del repositorio
GOOGLE_CREDENTIALS_PATH=~/.config/finanzas/google-oauth.json
# Dónde se guarda el permiso de Google (por defecto ~/.config/finanzas/google-token.json)
# GOOGLE_TOKEN_PATH=
# Nombre del libro en tu Drive
# DRIVE_NOMBRE_ARCHIVO=Finanzas (copia de la app).xlsx
