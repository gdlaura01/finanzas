# Copia este archivo como .env.local y rellénalo. Nunca lo subas al repositorio.

# Ruta de la base de datos (por defecto ./data/finanzas.db)
DB_PATH=./data/finanzas.db

# Acceso (fase 2): tu correo y el hash bcrypt de tu contraseña
APP_EMAIL=
APP_PASSWORD_HASH=
# Secreto para firmar la cookie de sesión (32 caracteres o más)
SESSION_SECRET=

# Google Drive (fase 7): ruta a las credenciales OAuth, fuera del repositorio
GOOGLE_CREDENTIALS_PATH=./credenciales/google-oauth.json
